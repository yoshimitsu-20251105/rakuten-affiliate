{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "opportunities.schema.json",
  "title": "Revenue Opportunity",
  "description": "市場・テーマ・キーワード単位の収益機会を管理する。UNKNOWNな数値はnullのまま残し、推測で埋めない。",
  "type": "object",
  "required": ["id", "name", "category", "revenueEngines", "status", "opportunityScore", "hypothesis", "unknowns", "nextAction", "reviewDate"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "一意なID(kebab-case推奨)" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "revenueEngines": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["VOLUME", "MARGIN", "RECURRING", "SUBSCRIPTION", "SEASONAL", "TREND", "LEAD", "B2B"] }
    },
    "status": { "enum": ["RESEARCH", "TEST", "SCALE", "HOLD", "KILL"] },
    "trafficScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "moneyScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "executionScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "durabilityScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "opportunityScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "searchVolume": { "type": ["number", "null"], "minimum": 0 },
    "searchIntent": { "type": ["string", "null"] },
    "serpDifficulty": { "type": ["string", "null"] },
    "seasonality": { "type": ["string", "null"] },
    "monetizationOptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hypothesis": { "type": "string", "minLength": 1 },
    "counterEvidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nextAction": { "type": "string", "minLength": 1 },
    "reviewDate": { "type": "string", "format": "date" }
  }
}
